# ==============================================================================
# CAREERPATH PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure these environment variables in Netlify Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------

# Google OAuth 2.0 Client ID for Google Sign-In button
# Obtain from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: http://localhost:3000, https://your-netlify-app.netlify.app
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API Base URL (Default relative path for Netlify Functions)
VITE_API_BASE_URL=/api


# ------------------------------------------------------------------------------
# 2. BACKEND SERVERLESS CONFIGURATION (Netlify Functions / Node.js)
# ------------------------------------------------------------------------------

# Google Spreadsheet ID
# Extracted from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE/edit
GOOGLE_SHEETS_ID=1A2B3C4D5E6F7G8H9I0J1K2L3M4N5O6P7Q8R9S0T

# Service Account Email
# Created in Google Cloud Console -> IAM & Admin -> Service Accounts
# MUST BE ADDED AS AN 'EDITOR' TO YOUR GOOGLE SPREADSHEET!
GOOGLE_SERVICE_ACCOUNT_EMAIL=careerpath-service-account@your-gcp-project.iam.gserviceaccount.com

# Service Account Private Key
# Downloaded JSON key file from GCP -> "private_key" field.
# Wrap in quotes and ensure newlines \n are preserved.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ..."


# ==============================================================================
# GOOGLE SHEET DATABASE TAB STRUCTURE & COLUMNS GUIDE
# Share your spreadsheet with your Service Account Email as Editor.
# Create the following tabs in your Google Spreadsheet:
# ==============================================================================
#
# Tab 1: "Students"
# Headers (Row 1): student_id | google_id | email | name | mobile | location | gender | college | branch | year | semester | profile_image | created_at | updated_at
#
# Tab 2: "Projects"
# Headers (Row 1): project_id | title | description | branch | project_type | technologies | difficulty | duration | cost | availability | capacity | image | created_at | updated_at
#
# Tab 3: "ProjectBookings"
# Headers (Row 1): booking_id | student_id | project_id | status | booked_at | updated_at
#
# Tab 4: "Jobs"
# Headers (Row 1): job_id | company | role | job_type | description | eligibility | location | skills | experience | deadline | apply_url | company_logo | created_at | updated_at
#
# Tab 5: "Courses"
# Headers (Row 1): course_id | title | focus_area | student_outcome | description | technologies | duration | level | category | cost | instructor | created_at | updated_at
#
# Tab 6: "CourseEnrollments"
# Headers (Row 1): enrollment_id | student_id | course_id | status | enrolled_at | updated_at
# ==============================================================================
