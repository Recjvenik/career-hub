rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users can only read and write their own profile data
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // Users can only access their own bookings and enrollments
      match /bookings/{bookingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /enrollments/{enrollmentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'gotechplace@gmail.com';
    }

    // 2. Catalogs are PUBLIC to read (anyone can view projects/jobs/courses)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
